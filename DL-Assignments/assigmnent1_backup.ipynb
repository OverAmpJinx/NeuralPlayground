    "# implementing model, loss func and optimizer\n",
    "\n",
    "model = nn.Sequential(\n",
    "    nn.Linear(8, 64), # input layer for 8 features to 64 neurons\n",
    "    nn.ReLU(), # ReLU activation function since it is very common\n",
    "    nn.Linear(64, 64),\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(64, 64), \n",
    "    nn.ReLU(),\n",
    "    nn.Linear(64,1) \n",
    ").to(device) # onto to the GPU!\n",
    "loss_fn = nn.MSELoss() # common mean squared err\n",
    "optimizer = torch.optim.SGD(model.parameters(), lr=0.001) # stochastic gradient descent lr=0.001\n",
    "\n",
    "\n",
    "# actual training loop for our feedforward neural network\n",
    "val_losses = []\n",
    "train_losses = [] # for later plotting\n",
    "\n",
    "for epoch in range(100): #TRAINING LOOP\n",
    "    model.train()\n",
    "    batch_loss = 0\n",
    "    \n",
    "    # for each batch of data, we do forward pass, loss calculation, backward pass and optimizer step\n",
    "    for X_batch, y_batch in train_loader:\n",
