    "        y_batch = y_batch.to(device).reshape(-1, 1) # had some shape mismatch, this should fix it\n",
    "        #first we do forward pass\n",
    "        y_pred = model(X_batch)\n",
    "        loss = loss_fn(y_pred, y_batch)\n",
    "        # loss calculation and backward pass\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        # keeping track of the loss for this batch\n",
