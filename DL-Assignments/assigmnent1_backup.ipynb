    "# Split Training Data into Training and Validation Sets first\n",
    "X_train, X_val, y_train, y_val = train_test_split(X_train_tot, y_train_tot, test_size=0.15, random_state=302)\n",
    "scaler = StandardScaler()\n",
    "train_split = scaler.fit_transform(X_train)\n",
    "val_split = scaler.transform(X_val)\n",
    "\n",
    "# turning them into torch tensors for later training\n",
    "X_train_split = torch.tensor(train_split, dtype=torch.float32).to(device)\n",
    "y_train_split = torch.tensor(y_train, dtype=torch.float32).to(device)\n",
    "X_val_split = torch.tensor(val_split, dtype=torch.float32).to(device)\n",
    "y_val_split = torch.tensor(y_val, dtype=torch.float32).to(device)\n",
    "\n",
    "# Getting familiar with the data, or what it's actually structured like\n",
    "# X has Dim (20640, 8) and y has Dim (20640,) \n",
    "features = [\n",
    "    \"MedianIncome\", \"HouseAge\", \"AvgRooms\", \"AvgBedrms\", \"Population\", \"AvgOccup\", \"Lattitude\", \"Longitude\"\n",
    "]\n",
    "for i in range(len(features)):\n",
    "    plt.figure(figsize=(5, 3), facecolor='#FFFFFF')\n",
    "    plt.plot(X_train[:, i], y_train, 'o', label=features[i], markersize=1, color='violet')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "\n",
    "# map of california with the data points\n",
