    "y_train_tot[y_train_tot < 2], y_test[y_test < 2] = 0, 0\n",
    "y_train_tot[y_train_tot >= 2], y_test[y_test >= 2] = 1, 1\n",
    "y_train_tot_tensor = torch.tensor(y_train_tot, dtype=torch.float32).to(device)\n",
    "y_test_tensor = torch.tensor(y_test, dtype=torch.float32).to(device)\n",
    "binary_train_data = torch.utils.data.TensorDataset(X_train_tot_tensor, y_train_tot_tensor)\n",
    "binary_train_loader = DataLoader(binary_train_data, batch_size=batch_size, shuffle=True)\n",
    "\n",
    "\n",
    "batch_size = 16\n",
    "lr = 0.001\n",
    "\n",
    "# now define a new model \n",
